---
import Base from '@layouts/Base.astro';
import EntityCard from '@components/EntityCard.astro';
import WaveDivider from '@components/WaveDivider.astro';
import Atlas from '@islands/Atlas';
import { getPorts, getRoutes, getSites, getPeriods, getGoods, getSources, getFacts, getInscriptions } from '@data/load';

const ports = getPorts();
const routes = getRoutes();
const sites = getSites();
const inscriptions = getInscriptions();
const periods = getPeriods();
const goods = getGoods();
const sources = getSources();
const facts = getFacts();
const base = import.meta.env.BASE_URL;

/** How many cards each home-page section shows before "See all". */
const PREVIEW = 6;
const kalingaPorts = ports.filter((p) => p.region === 'kalinga');

const sections = [
  {
    id: 'routes',
    title: 'Trade Routes',
    blurb: 'Follow the sea lanes, coast roads and rivers that carried Kalinga’s ships and caravans.',
    href: `${base}routes/`,
    kind: 'route' as const,
    items: routes,
    total: routes.length,
  },
  {
    id: 'ports',
    title: 'Ancient Ports',
    blurb: 'Harbours on the Odisha coast where ships were loaded, taxed and sent across the Bay of Bengal.',
    href: `${base}ports/`,
    kind: 'port' as const,
    items: kalingaPorts,
    total: ports.length,
  },
  {
    id: 'goods',
    title: 'Goods & Commodities',
    blurb: 'What was in the ship? Elephants, cloth, salt, shells and more, each with the record that proves it.',
    href: `${base}goods/`,
    kind: 'good' as const,
    items: goods,
    total: goods.length,
  },
  {
    id: 'evidence',
    title: 'Archaeological Evidence',
    blurb: 'Dug-up cities, carved edicts and broken pots: the hard evidence behind every claim on this site.',
    href: `${base}evidence/`,
    kind: 'site' as const,
    items: sites,
    total: sites.length + inscriptions.length,
  },
];
---

<Base
  title="Kalinga: Ancient Trade Routes"
  description="Explore how Odisha connected with the world across two millennia, port by port, route by route, century by century."
>
  <section class="hero">
    <h1>Kalinga: Ancient Trade Routes</h1>
    <p class="lede">
      Explore how Odisha connected with the world across two millennia, port by port, route by route, century by century.
    </p>
    <p class="hint">
      Drag the timeline to change the century. Tap a glowing dot to open a port. Every fact shows how sure we are and
      where it comes from.
    </p>
  </section>

  <section class="atlas" aria-label="Interactive atlas">
    {
      periods.length > 0 ? (
        <Atlas
          client:visible
          ports={ports}
          routes={routes}
          sites={sites}
          periods={periods}
          goods={goods}
          facts={facts}
          sources={sources}
        />
      ) : (
        <p class="empty">No published periods yet.</p>
      )
    }
  </section>

  {
    sections.map((s) => (
      <section id={s.id} class="section" aria-labelledby={`${s.id}-heading`}>
        <WaveDivider />
        <div class="section-head">
          <div>
            <h2 id={`${s.id}-heading`}>{s.title}</h2>
            <p class="blurb">{s.blurb}</p>
          </div>
          <a class="see-all" href={s.href}>
            See all {s.total} <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
        {s.items.length === 0 ? (
          <p class="empty">Nothing published in this section yet.</p>
        ) : (
          <ul class="cards">
            {s.items.slice(0, PREVIEW).map((e) => (
              <EntityCard kind={s.kind} entity={e} sources={sources} />
            ))}
          </ul>
        )}
      </section>
    ))
  }

  <section class="section about" aria-labelledby="about-heading">
    <WaveDivider />
    <h2 id="about-heading">How to read this atlas</h2>
    <p>
      Every port, route, good and site on this site comes from a published book, report or inscription. Next to each one
      you will see two small badges. The first says how sure historians are: <strong>Confirmed</strong>,
      <strong>Strongly Supported</strong>, <strong>Probable</strong> or <strong>Hypothetical</strong>. The second says what kind of
      evidence it is: something archaeologists found, something scholars worked out, or a story passed down.
    </p>
    <p>
      Tap any citation to see the full reference, or browse the whole list on the <a href={`${base}sources/`}>Sources</a> page.
      Nothing here is invented, and where historians are unsure, the site says so.
    </p>
  </section>
</Base>

<style>
  .hero { padding: var(--space-12) var(--gutter) var(--space-6); max-width: var(--content-max); margin: 0 auto; }
  .lede { font-size: var(--text-lg); color: var(--fg-muted); max-width: 46rem; }
  .hint { max-width: 46rem; color: var(--fg-muted); font-size: var(--text-sm); }
  .atlas { padding: 0 var(--gutter); max-width: var(--content-max); margin: 0 auto; }
  .section { padding: var(--space-6) var(--gutter) var(--space-8); max-width: var(--content-max); margin: 0 auto; }
  .section-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-2) var(--space-6);
    margin-bottom: var(--space-4);
  }
  .section-head h2 { margin-bottom: var(--space-1); }
  .blurb { color: var(--fg-muted); max-width: 40rem; margin: 0; }
  .see-all {
    white-space: nowrap;
    font-weight: 600;
    text-decoration: none;
    border-bottom: 2px solid var(--highlight);
    padding: var(--space-1) 0;
    min-height: var(--hit-min);
    display: inline-flex;
    align-items: center;
  }
  .empty { color: var(--fg-muted); font-style: italic; }
  .cards {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
  }
  .about p { max-width: 46rem; }
</style>
