---
/**
 * Shared card for a port, route, good, site or inscription across the
 * section index pages. Mirrors the `.card` pattern originally inline in
 * index.astro (moved here, not duplicated there — see the engineer report
 * for the index.astro follow-up).
 */
import type { Port, Route, Good, Site, Inscription, Source } from '@data/schema';
import EvidenceBadge from './EvidenceBadge.astro';
import SourcePopover from './SourcePopover.astro';
import { withBase } from '@lib/base-url';

type Kind = 'port' | 'route' | 'good' | 'site' | 'inscription';
type Entity = Port | Route | Good | Site | Inscription;

interface Props {
  kind: Kind;
  entity: Entity;
  sources: Source[];
  /**
   * improvement-plan owner item 4: sort keys for the client-side re-sort
   * script (@lib/sort-list-client) plus a legible label so the order makes
   * sense without reading the DOM. All optional — cards used outside a
   * sortable listing (e.g. a detail page's "related" list) just omit them.
   */
  sortTime?: number;
  sortEvidenceRank?: number;
  earliestPeriodLabel?: string;
}

const { kind, entity, sources, sortTime, sortEvidenceRank, earliestPeriodLabel } = Astro.props;

const PATH: Record<Kind, string> = {
  port: 'ports',
  route: 'routes',
  good: 'goods',
  site: 'sites',
  inscription: 'inscriptions',
};

const href = withBase(`${PATH[kind]}/${entity.id}/`);
const description = kind === 'good' ? (entity as Good).kid_line : entity.summary;
---

<li
  class="card"
  data-sort-time={sortTime ?? ''}
  data-sort-evidence={sortEvidenceRank ?? ''}
  data-sort-name={entity.name.toLowerCase()}
>
  <h3><a href={href}>{entity.name}</a></h3>
  <p>{description}</p>
  {earliestPeriodLabel && <p class="sort-hint">Earliest: {earliestPeriodLabel}</p>}
  <div class="meta">
    <EvidenceBadge level={entity.evidence_level} type={entity.evidence_type} compact />
    <SourcePopover refs={entity.source_refs} sources={sources} />
  </div>
</li>

<style>
  .card {
    background: var(--bg-elevated);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    box-shadow: var(--shadow-card);
    list-style: none;
    display: flex;
    flex-direction: column;
  }
  .card h3 { margin-bottom: var(--space-2); }
  .card h3 a {
    color: var(--fg);
    text-decoration: none;
  }
  .card h3 a:hover,
  .card h3 a:focus-visible {
    text-decoration: underline;
  }
  .card p { flex-grow: 1; }
  .card p.sort-hint { flex-grow: 0; font-size: var(--text-xs); color: var(--fg-muted); margin: 0; }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }
</style>
